<Window x:Class="Kuznecov_41.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kuznecov_41"
        mc:Ignorable="d"
        Title="OrderWindow" Height="600" Width="800" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="125"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата формирования заказа" FontSize="20" Width="230"></TextBlock>
                <DatePicker Name="OrderDP" SelectedDateFormat="Short" Width="530" IsEnabled="False"></DatePicker>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Дата доставки заказа" FontSize="20" Width="230"></TextBlock>
                <DatePicker Name="deliveryDP" SelectedDateFormat="Short" Width="530" IsEnabled="False"></DatePicker>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ФИО клиента" FontSize="20" Width="230"></TextBlock>
                    <TextBlock Name="FIOTB" Text="Гость" FontSize="18" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Номер заказа" FontSize="20" Width="230"></TextBlock>
                    <TextBlock Name="OrderNumberTB" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>

        <ListView Name="ShoeListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="150" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Image/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding ProductDescription}" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Text="{Binding ProductManufacturer}" Margin="0,3"/>
                                <TextBlock Text="{Binding ProductCost, StringFormat={}{0} рублей}" Margin="0,3"/>
                           
                            
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Name="BtnMinus" Content="-" Width="30" Height="30" Click="BtnMinus_Click"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="18" Margin="10,0" VerticalAlignment="Center"/>
                                <Button Name="BtnPlus" Content="+" Width="30" Height="30" Click="BtnPlus_Click"/>
                            </StackPanel>
                        </StackPanel>


                        <StackPanel Orientation="Vertical" Grid.Column="2" Margin="15">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0:0}%}" HorizontalAlignment="Center" FontSize="40" Margin="0,0,0,30"></TextBlock>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <StackPanel Grid.Row="2" Margin="0,10">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Сумма заказа: " FontSize="16" FontWeight="Bold"/>
                <TextBlock Name="TotalSumTB" FontSize="16" Margin="5,0,20,0"/>

                <TextBlock Text="Размер скидки: " FontSize="16" FontWeight="Bold"/>
                <TextBlock Name="TotalDiscountTB" FontSize="16" Margin="5,0"/>
            </StackPanel>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Пункт выдачи" Grid.Column="0" VerticalAlignment="Center" FontSize="16"/>
                <ComboBox Name="PickupCombo" Grid.Column="1" FontSize="16">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PickupPointPosalIndex}" Margin="0,0,5,0"/>
                        <TextBlock Text="г. "/>
                        <TextBlock Text="{Binding PickupPointcity}" Margin="0,0,5,0"/>
                        <TextBlock Text="ул. "/>
                        <TextBlock Text="{Binding PickupPointstreet}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding PickupPointhouse}"/>
                    </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Кнопка сохранения -->
        <Button Name="SaveBtn" Grid.Row="3" Content="Сохранить" Width="200" Height="40"
             FontSize="18" Click="SaveBtn_Click" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
