<Window x:Class="Kuznecov_41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kuznecov_41"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/Image/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Left" Source="Image\logo.png"/>
        <TextBlock Text="Kuznecov41" Grid.Row="0" HorizontalAlignment="Center" FontSize="30" FontFamily="Comic Sans MS" VerticalAlignment="Center"></TextBlock>
        <Button Content="Назад" Grid.Row="0" Name ="Btn_Back" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontFamily="Comic Sans MS" Background="#CC6600" Click="Btn_Back_Click" ></Button>
        <Frame Grid.Row="1" Name ="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
