<Page x:Class="Kuznecov_41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kuznecov_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnViewOrder" Content="Просмотр заказа" Visibility="Collapsed" Click="BtnViewOrder_Click" Grid.Row="0" HorizontalAlignment="Right"/>
            <StackPanel Grid.Row="0"
        HorizontalAlignment="Right"
        Margin="10">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="TBlockAuthLabel"
                   Text="Вы вошли как: "/>

                    <TextBlock Name="FIOTB"
                   Text="Гость"
                   FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Роль: "/>
                    <TextBlock Name="RoleTB"
                   Text="Гость"
                   FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        
        <StackPanel  Margin="0,0,0,25" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Кол-во __ из __" Name="amountCounter" Margin="0,0,15,0" FontSize="20" VerticalAlignment ="Center" Grid.Row ="1"></TextBlock>
            <StackPanel Margin="0,0,15,0" Orientation="Horizontal" VerticalAlignment ="Center" Grid.Row ="1">
                <TextBlock Text="Поиск по ноименованию" FontSize="20"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" FontSize="15" Margin="15,0,0,0"  Width="200"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Vertical" Grid.Row ="1">
                <TextBlock Text="Фильтрация по скидке" FontSize="20"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 10%</TextBlock>
                    <TextBlock>от 10 до 15%</TextBlock>
                    <TextBlock>от 15 до 100%</TextBlock>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,10" Grid.Row ="1">
                <RadioButton Content="По возрастанию стоимости" FontSize="20" Checked="RButtonUp_Checked" Name="RButtonUp" VerticalContentAlignment="Center" Margin="0,0,20,20"></RadioButton>
                <RadioButton Content="По убыванию стоимости" FontSize="20" Checked="RButtonDown_Checked" Name="RButtonDown" VerticalContentAlignment="Center" ></RadioButton>
            </StackPanel>
        </StackPanel>

        <ListView Name="ProductListView" HorizontalContentAlignment="Stretch" Grid.Row="2">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click_1"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="100"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Image Width="150" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPath">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                Image/picture.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="15">
                            <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,25" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"></TextBlock>
                            <TextBlock Text="{Binding ProductManufacturer}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Grid.Column="2" Margin="15">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0:0}%}" HorizontalAlignment="Center" FontSize="40" Margin="0,0,0,30"></TextBlock>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
      
    </Grid>
</Page>
