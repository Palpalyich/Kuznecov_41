<Page x:Class="Kuznecov_41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kuznecov_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        
        <ListView Name="ProductListView" HorizontalContentAlignment="Stretch" Grid.Row="2">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="100"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Image Width="150" Grid.Column="0" Grid.RowSpan="4" Stretch="Uniform" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPath">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                Image/picture.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="15">
                            <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,25" FontWeight="Bold"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"></TextBlock>
                            <TextBlock Text="{Binding ProductManufacturer}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" HorizontalAlignment="Left" FontSize="18" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Grid.Column="2" Margin="15">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0:0}%}" HorizontalAlignment="Center" FontSize="40" Margin="0,0,0,30"></TextBlock>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
