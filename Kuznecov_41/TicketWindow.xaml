<Window x:Class="Kuznecov_41.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kuznecov_41"
        mc:Ignorable="d"
        Title="TicketWindow" Height="450" Width="800" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область, которая пойдет на печать / в PDF -->
        <Border Name="PrintArea" Grid.Row="0" BorderThickness="1" Padding="15" Background="White">
            <StackPanel>
                <TextBlock Text="ООО «41 размер»" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="ТАЛОН ЗАКАЗА" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <TextBlock Name="OrderNumTB" FontSize="14" Margin="0,2"/>
                <TextBlock Name="OrderDateTB" FontSize="14" Margin="0,2"/>
                <TextBlock Name="DeliveryDateTB" FontSize="14" Margin="0,2"/>
                <TextBlock Name="DeliveryDaysTB" FontSize="14" FontWeight="Bold" Margin="0,2"/>
                <TextBlock Name="PickupPointTB" FontSize="14" TextWrapping="Wrap" Margin="0,2"/>
                <TextBlock Name="ClientTB" FontSize="14" Margin="0,2"/>

                <Separator Margin="0,10"/>
                <TextBlock Text="Состав заказа:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                <!-- Список купленных позиций -->
                <ItemsControl Name="ProductsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0} шт.}" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10"/>
                <TextBlock Name="TotalSumTB" FontSize="15" FontWeight="Bold" Margin="0,2"/>
                <TextBlock Name="TotalDiscountTB" FontSize="14" Margin="0,2"/>

                <!-- Код получения заказа (крупно и жирно) -->
                <Border BorderThickness="1" Margin="0,15,0,0" Padding="10" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="КОД ПОЛУЧЕНИЯ:" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Name="OrderCodeTB" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Кнопка сохранения в PDF / печати -->
        <Button Name="PrintBtn" Grid.Row="1" Content="Сохранить в PDF / Печать" Height="40" Margin="0,10,0,0" FontSize="16" Click="PrintBtn_Click"/>
    </Grid>
</Window>
